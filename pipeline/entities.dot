digraph warehouse {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="Food delivery: business entities", labelloc=t, fontsize=22];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=10, color="#536477", arrowsize=0.7];
"customers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8b9bac"><TR><TD COLSPAN="3" BGCOLOR="#dcebf6"><B>core.customers</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD PORT="customer_id" ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="family_name" ALIGN="LEFT">family_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="given_name" ALIGN="LEFT">given_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="patronymic" ALIGN="LEFT">patronymic</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="full_name" ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="phone" ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">text ?</TD></TR></TABLE>>];
"couriers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8b9bac"><TR><TD COLSPAN="3" BGCOLOR="#dcebf6"><B>core.couriers</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD PORT="courier_id" ALIGN="LEFT">courier_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="family_name" ALIGN="LEFT">family_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="given_name" ALIGN="LEFT">given_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="patronymic" ALIGN="LEFT">patronymic</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="full_name" ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">text ?</TD></TR></TABLE>>];
"restaurants" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8b9bac"><TR><TD COLSPAN="3" BGCOLOR="#dcebf6"><B>core.restaurants</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD PORT="restaurant_id" ALIGN="LEFT">restaurant_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="restaurant_name" ALIGN="LEFT">restaurant_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="city" ALIGN="LEFT">city</TD><TD ALIGN="LEFT">text</TD></TR></TABLE>>];
"dishes" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8b9bac"><TR><TD COLSPAN="3" BGCOLOR="#dcebf6"><B>core.dishes</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD PORT="dish_id" ALIGN="LEFT">dish_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="dish_name" ALIGN="LEFT">dish_name</TD><TD ALIGN="LEFT">text</TD></TR></TABLE>>];
"orders" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8b9bac"><TR><TD COLSPAN="3" BGCOLOR="#dcebf6"><B>core.orders</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD PORT="order_id" ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="ordered_at" ALIGN="LEFT">ordered_at</TD><TD ALIGN="LEFT">timestamp without time zone</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD PORT="customer_id" ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD PORT="restaurant_id" ALIGN="LEFT">restaurant_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD PORT="courier_id" ALIGN="LEFT">courier_id</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="fulfillment_type" ALIGN="LEFT">fulfillment_type</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="customer_phone_extension" ALIGN="LEFT">customer_phone_extension</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="total_amount" ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT">numeric(14,2)</TD></TR></TABLE>>];
"order_items" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#8b9bac"><TR><TD COLSPAN="3" BGCOLOR="#dcebf6"><B>core.order_items</B></TD></TR><TR><TD ALIGN="LEFT">PK,FK</TD><TD PORT="order_id" ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD PORT="line_no" ALIGN="LEFT">line_no</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD PORT="dish_id" ALIGN="LEFT">dish_id</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">integer</TD></TR></TABLE>>];
"dishes":"dish_id" -> "order_items":"dish_id" [taillabel="1", headlabel="0..N", label="dish_id", arrowhead=none];
"orders":"order_id" -> "order_items":"order_id" [taillabel="1", headlabel="1", label="order_id", arrowhead=none];
"couriers":"courier_id" -> "orders":"courier_id" [taillabel="0..1", headlabel="0..N", label="courier_id", arrowhead=none];
"customers":"customer_id" -> "orders":"customer_id" [taillabel="1", headlabel="0..N", label="customer_id", arrowhead=none];
"restaurants":"restaurant_id" -> "orders":"restaurant_id" [taillabel="1", headlabel="0..N", label="restaurant_id", arrowhead=none];
}
